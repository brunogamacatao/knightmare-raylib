<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="false"
        android:hasCode="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/GameTheme"
        android:isGame="true">

        <!-- No Java/Kotlin code in this module at all: android.app.NativeActivity is a
             framework-provided Activity that hosts a native window and forwards its lifecycle to
             the shared library named below, whose android_main() (provided by raylib itself when
             built with PLATFORM=Android - see rcore_android.c) drives everything from there. -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="knightmare" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
